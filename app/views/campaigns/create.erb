<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Opret indsamling - DonationPlatform</title>
    <link rel="stylesheet" href="/css/site.css?v=20260324-10">
</head>
<body>
    <header class="site-header">
        <nav class="nav-container" aria-label="Hovedmenu">
            <a class="brand" href="/">Danmarks Donation</a>
            <ul class="nav-links">
                <li><a href="/#campaign-list">Kampagner</a></li>
                <li><a href="/campaigns/new">Opret indsamling</a></li>
                <li>
                    <a href="<%= account_link_path %>" class="account-link">
                        <span class="lock-icon <%= account_lock_state %>" aria-hidden="true"><span class="lock-keyhole"></span></span>
                        <span><%= account_link_label %></span>
                    </a>
                </li>
            </ul>
        </nav>
    </header>

    <main class="page-content">
        <section class="detail-card">
            <h1>Opret en ny indsamling</h1>
            <p class="subtitle">Udfyld detaljerne nedenfor. Kampagner bliver gennemgået, så brugerne altid får en gennemsigtig platform.</p>
        </section>

        <section class="create-layout" aria-label="Opret kampagne">
            <article class="detail-card">
                <form action="/campaigns" method="POST" enctype="multipart/form-data" class="donation-form campaign-create-form">
                    <label for="input-titel">Titel</label>
                    <input type="text" name="titel" id="input-titel" placeholder="Skriv din titel her" required>

                    <label for="input-kategori">Kategori</label>
                    <select name="kategori" id="input-kategori">
                        <option value="">Vælg kategori</option>
                        <option value="klima">Klima</option>
                        <option value="lokalt">Lokalt</option>
                        <option value="sundhed">Sundhed</option>
                        <option value="dyr">Dyr</option>
                    </select>

                    <label for="input-beloeb">Beløbsmål</label>
                    <input type="number" name="beloeb" id="input-beloeb" placeholder="kr" min="1" required>

                    <label for="input-deadline">Deadline</label>
                    <input type="date" name="deadline" id="input-deadline">

                    <label for="input-beskrivelse">Beskrivelse</label>
                    <textarea name="beskrivelse" id="input-beskrivelse" rows="4" placeholder="Beskriv formålet"></textarea>

                    <label for="file-input">Upload billede</label>
                    <div class="upload-zone" id="drop-zone">
                        <input type="file" name="billede" id="file-input" accept="image/*" hidden>
                        <p>Træk et billede hertil eller <strong>vælg fil</strong></p>
                        <span>JPEG eller PNG, maks 5 MB</span>
                    </div>

                    <div class="info-box">
                        <p>Alle indsamlinger verificeres for kvalitet og tydelighed, så donorer nemt kan træffe oplyste valg.</p>
                    </div>

                    <button type="submit" class="btn-primary">Send til godkendelse</button>
                    <p class="terms">Ved indsendelse accepterer du platformens retningslinjer.</p>
                </form>
            </article>

            <aside class="campaign-card" aria-label="Forhåndsvisning">
                <div class="preview-media" id="preview-media-container">
                    <img id="preview-img" src="https://via.placeholder.com/800x450?text=Kampagne" alt="Forhåndsvisning af kampagnebillede">
                </div>
                <div class="card-body">
                    <p class="campaign-category">Forhåndsvisning</p>
                    <h2 id="preview-titel">Din kampagne titel</h2>
                    <p id="preview-beskrivelse" class="preview-desc">Beskrivelse af hvad du samler ind til.</p>
                    <p class="detail-description"><strong>0 kr</strong> af <span id="preview-maale">0</span> kr</p>
                    <div class="progress-bar"><div class="fill"></div></div>
                    <div class="card-footer">
                        <span>0 donationer</span>
                        <button type="button" class="btn-secondary" disabled>Donér</button>
                    </div>
                </div>
            </aside>
        </section>
    </main>

    <%= erb :'shared/footer', layout: false %>

    <script src="/js/campaign_creation.js"></script>
</body>
</html>
