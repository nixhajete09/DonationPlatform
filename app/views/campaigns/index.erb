<!DOCTYPE html>
<html lang="da">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kampagner - DonationPlatform</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <nav class="nav-container" aria-label="Hovedmenu">
      <a class="brand" href="/">Danmarks Donation</a>
      <ul class="nav-links">
        <li><a href="/campaigns">Kampagner</a></li>
        <li><a href="/campaigns/new">Opret kampagne</a></li>
        <li><a href="/profile">Log ind</a></li>
      </ul>
    </nav>
  </header>

  <main class="page-content">
    <section class="detail-card">
      <h1>Kampagner</h1>
      <p class="detail-description">Vælg en kampagne for at se flere detaljer.</p>

      <form action="/campaigns" method="get" class="campaign-search-form" role="search" aria-label="Søg kampagner">
        <input type="hidden" name="category" value="<%= @selected_category %>">
        <input
          type="search"
          name="q"
          value="<%= @query %>"
          placeholder="Søg efter kampagne, kategori eller formål"
          class="campaign-search-input"
        >
        <button type="submit" class="campaign-search-button">Søg</button>
      </form>

      <% category_emojis = { 'Alle' => '✨', 'Klima' => '🌿', 'Dyr' => '🐾', 'Sundhed' => '❤️', 'Lokalt' => '🏘️' } %>
      <section class="categories" aria-label="Filtrer kampagner efter kategori">
        <% (@categories || ['Alle']).each do |category| %>
          <% active = (@selected_category == category) %>
          <a href="/campaigns?category=<%= category %>" class="chip<%= active ? ' chip-active' : '' %>">
            <%= category_emojis[category] || '📌' %> <%= category %>
          </a>
        <% end %>
      </section>
    </section>

    <section class="campaign-grid" aria-label="Kampagneliste">
      <% if @campaigns.empty? %>
        <p class="empty-state">Ingen kampagner matcher din søgning.</p>
      <% else %>
        <% @campaigns.each_with_index do |campaign, index| %>
          <% campaign_id = campaign.id || (index + 1) %>
          <% collected = collected_amount_for_campaign(campaign) %>
          <% progress = progress_percentage(collected, campaign.goal) %>
          <article class="campaign-card">
            <div
              class="campaign-image"
              style="<%= campaign.image_url.to_s.strip.empty? ? '' : "background-image: url('" + campaign.image_url + "');" %>"
            ></div>
            <div class="campaign-content">
              <p class="campaign-category"><%= campaign.category %></p>
              <h2><a href="/campaigns/<%= campaign_id %>" class="campaign-title-link"><%= campaign.title %></a></h2>
              <p><%= campaign.description %></p>
              <div class="campaign-progress" aria-label="Fremgang <%= progress %> procent">
                <div class="campaign-progress-fill" style="width: <%= progress %>%;"></div>
              </div>
              <div class="campaign-meta">
                <span><%= collected %> kr af <%= campaign.goal %> kr</span>
                <a href="/campaigns/<%= campaign_id %>" class="card-link">Se kampagne</a>
              </div>
            </div>
          </article>
        <% end %>
      <% end %>
    </section>
  </main>

  <%= erb :'shared/footer', layout: false %>
</body>
</html>
