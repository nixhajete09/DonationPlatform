<!DOCTYPE html>
<html lang="da">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Min profil - DonationPlatform</title>
  <link rel="stylesheet" href="/css/site.css">
</head>
<body>
  <header class="site-header">
    <nav class="nav-container" aria-label="Hovedmenu">
      <a class="brand" href="/">Danmarks Donation</a>
      <ul class="nav-links">
        <li><a href="/campaigns">Kampagner</a></li>
        <li><a href="/campaigns/new">Opret indsamling</a></li>
        <li><a href="/profile">Min profil</a></li>
      </ul>
    </nav>
  </header>

  <main class="page-content">
    <section class="detail-card">
      <h1>Min profil</h1>
      <p class="detail-description"><strong><%= @profile_name %></strong> - <%= @profile_email %></p>
    </section>

    <section class="campaign-grid" aria-label="Profiloversigt">
      <article class="campaign-card">
        <div class="campaign-content">
          <p class="campaign-category">Donationer</p>
          <h2>I alt doneret</h2>
          <p><strong><%= @total_donated %> kr</strong></p>
        </div>
      </article>

      <article class="campaign-card">
        <div class="campaign-content">
          <p class="campaign-category">Skat</p>
          <h2>Fradragsberettiget</h2>
          <p><strong><%= @tax_deduction_total %> kr</strong></p>
        </div>
      </article>

      <article class="campaign-card">
        <div class="campaign-content">
          <p class="campaign-category">Handlinger</p>
          <h2>Hurtige links</h2>
          <p><a href="/campaigns" class="card-link">Find nye kampagner</a></p>
          <p><a href="#" class="card-link">Se skattekvitteringer</a></p>
        </div>
      </article>
    </section>

    <section class="detail-card">
      <h2>Mine seneste donationer</h2>
      <p class="detail-description">Overblik over dine bidrag.</p>

      <% if @donation_history.empty? %>
        <p class="empty-state">Du har endnu ikke doneret.</p>
      <% else %>
        <% @donation_history.each do |donation| %>
          <article class="campaign-card" style="margin-bottom: 0.8rem;">
            <div class="campaign-content">
              <h3><%= donation[:campaign] %></h3>
              <p><strong><%= donation[:amount] %> kr</strong> - <%= donation[:date] %></p>
              <p><%= donation[:tax_deduction] ? 'Skattefradrag: Ja' : 'Skattefradrag: Nej' %></p>
            </div>
          </article>
        <% end %>
      <% end %>
    </section>
  </main>

  <%= erb :'shared/footer', layout: false %>
</body>
</html>
